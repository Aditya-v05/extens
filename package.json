{
  "name": "sift",
  "description": "Open-source Chrome extension: ICP fit, best contact and email for the company website you're on. Bring your own Apollo + Jev keys.",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit && tsc --noEmit -p site",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "smoke": "node e2e/smoke.mjs",
    "store-shots": "node e2e/store-shots.mjs",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  },
  "engines": {
    "node": ">=22"
  }
}
